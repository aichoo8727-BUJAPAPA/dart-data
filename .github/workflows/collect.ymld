name: collect-dart
on:
  schedule:
    - cron: "0 21 * * *"   # 매일 한국시간 오전 6시 (UTC 21:00)
  workflow_dispatch:        # 손으로 실행 버튼도 가능
permissions:
  contents: write
jobs:
  collect:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install requests
      - name: OpenDART 수집
        env:
          DART_API_KEY: ${{ secrets.DART_API_KEY }}
        run: python collect_dart.py
      - name: 결과 저장(변경이 있을 때만)
        run: |
          git config user.name "dart-bot"
          git config user.email "dart-bot@users.noreply.github.com"
          git add data
          git diff --cached --quiet || git commit -m "OpenDART 데이터 갱신 $(date -u +%F)"
          git push
